# Configuration Brother OCR.
# Windows : copier ce fichier en `.env` à côté de brother_ocr.py.
# Linux   : linux/install.sh le copie dans ~/.config/brother-ocr/env.
# Ne jamais versionner le fichier contenant la vraie clé.

# Fournisseur : opencode ou deepseek
# (numer.py force opencode, numerisation.py force deepseek)
OCR_PROVIDER=opencode

# Clé API : clé propre au fournisseur, ou OCR_API_KEY qui prime sur les deux
OPENCODE_API_KEY=
DEEPSEEK_API_KEY=
#OCR_API_KEY=

# Modèle (facultatif, sinon celui par défaut du fournisseur)
#MODEL_NAME=deepseek-v4.1-flash

# Dossiers (facultatif). Par défaut :
#   Windows : C:\Brother\In et C:\Brother\Out
#   Linux   : ~/Brother/In et ~/Brother/Out
#WATCH_DIR=~/Brother/In
#OUTPUT_DIR=~/Brother/Out
